# =============================================================================
# Конфигурация развёртывания почтового сервера (mailcow: dockerized, Debian 12)
# =============================================================================
# Скопируйте этот файл в .env и заполните значения:
#     cp .env.example .env && chmod 600 .env && nano .env
#
# ВАЖНО: .env содержит пароли и ключи. Права должны быть 600, в git не коммитим.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Домен и имя хоста  (ОБЯЗАТЕЛЬНО)
# -----------------------------------------------------------------------------
# Основной почтовый домен — то, что после @ в адресах.
MAIL_DOMAIN=example.com

# FQDN самого сервера. Должен отличаться от MAIL_DOMAIN и иметь A/AAAA-запись.
# Именно это имя сервер сообщает в SMTP HELO и на него выпускается сертификат.
MAIL_HOSTNAME=mail.example.com

# Часовой пояс контейнеров.
TZ=Europe/Moscow

# -----------------------------------------------------------------------------
# 2. Администратор
# -----------------------------------------------------------------------------
# Адрес для Let's Encrypt (уведомления об истечении сертификатов) и отчётов.
ADMIN_EMAIL=admin@example.com

# Пароль администратора mailcow задаётся ТОЛЬКО вручную в веб-панели.
# После установки войдите с логином admin и паролем moohoo, затем смените его:
#   System → Administrator → Change password
# Автоматизировать это нельзя: mailcow не предоставляет API для смены
# пароля администратора, а правка хэша в базе напрямую ненадёжна.

# Первый почтовый ящик, который создаст postinstall.
FIRST_MAILBOX_LOCAL=admin
FIRST_MAILBOX_NAME=Администратор
FIRST_MAILBOX_QUOTA_MB=3072
# Пароль первого ящика. Пусто — будет сгенерирован.
FIRST_MAILBOX_PASSWORD=

# -----------------------------------------------------------------------------
# 3. Доступ по SSH (используется скриптом security/10-harden-ssh.sh)
# -----------------------------------------------------------------------------
# Нестандартный порт снижает шум от ботов. 22 тоже допустим.
SSH_PORT=22

# Пользователь, которому оставляем вход по SSH (кроме root).
# Должен существовать и иметь ваш публичный ключ в ~/.ssh/authorized_keys.
SSH_ALLOW_USER=deploy

# Запретить вход root по SSH: yes / no
# ВНИМАНИЕ: перед установкой в «yes» убедитесь, что вход под SSH_ALLOW_USER
# работает и у него есть sudo, иначе потеряете доступ к серверу.
SSH_DISABLE_ROOT=yes

# Запретить аутентификацию по паролю (только ключи): yes / no
# Ставьте «yes» только после проверки входа по ключу.
SSH_DISABLE_PASSWORD=yes

# Список IP/подсетей, которым разрешён SSH. Пусто = разрешить всем.
# Пример: SSH_ALLOWED_IPS="203.0.113.10,198.51.100.0/24"
SSH_ALLOWED_IPS=

# -----------------------------------------------------------------------------
# 4. Сеть и firewall
# -----------------------------------------------------------------------------
# Открывать ли устаревший SMTP-порт 465 (SMTPS). Обычно нужен для совместимости.
OPEN_PORT_465=yes

# Открывать ли POP3 (110/995). Если пользуетесь только IMAP — оставьте «no».
OPEN_POP3=no

# Порт веб-панели. Менять только если 443 занят другим сервисом.
HTTPS_PORT=443
HTTP_PORT=80

# Включить IPv6 в mailcow: yes / no
# Ставьте «no», если у VPS нет рабочего IPv6 и корректной PTR-записи для него.
ENABLE_IPV6=no

# -----------------------------------------------------------------------------
# 5. Антиспам и защита
# -----------------------------------------------------------------------------
# Порог fail2ban для SSH (число неудачных попыток до бана).
F2B_MAXRETRY=5
# Время бана SSH в секундах (86400 = сутки).
F2B_BANTIME=86400
# Окно подсчёта попыток в секундах.
F2B_FINDTIME=600

# Политика DMARC для генератора DNS-записей: none | quarantine | reject
# Начинайте с «none», через 2-4 недели наблюдений переходите на «quarantine»,
# затем на «reject».
DMARC_POLICY=none

# Адрес для агрегированных отчётов DMARC (rua).
DMARC_RUA=dmarc@example.com

# -----------------------------------------------------------------------------
# 6. Резервное копирование
# -----------------------------------------------------------------------------
# Каталог для бэкапов. Желательно отдельный диск или сетевое хранилище.
BACKUP_DIR=/var/backups/mailcow

# Сколько дней хранить бэкапы.
BACKUP_KEEP_DAYS=14

# Время ежедневного бэкапа (формат systemd OnCalendar).
BACKUP_SCHEDULE=03:30

# -----------------------------------------------------------------------------
# 7. Служебное
# -----------------------------------------------------------------------------
# Каталог установки mailcow.
MAILCOW_DIR=/opt/mailcow-dockerized

# Ветка mailcow: master (стабильная) или nightly (тестовая, не для продакшена).
MAILCOW_BRANCH=master

# API-ключ mailcow. Заполняется автоматически скриптом 40-postinstall.sh
# либо вручную: веб-панель → Configuration → Access → API.
MAILCOW_API_KEY=

# Пропустить интерактивные подтверждения (для CI/автоматизации): 1 или пусто.
ASSUME_YES=
